{
  "name": "nova-ads-console",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Nova Ads Console (cloud edition): remote MCP server, OAuth and dashboard for Google Ads on the Cloudflare free plan",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test-ui",
    "test": "vitest run && vitest run -c vitest.ui.config.ts",
    "gen:migration": "node scripts/gen-migration.mjs",
    "gen:ads-schema": "node scripts/make-ads-schema-fixture.mjs v25",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:worker": "vitest run",
    "test:ui": "vitest run -c vitest.ui.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22"
  }
}
